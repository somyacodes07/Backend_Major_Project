{
  "name": "small-business-crm-backend",
  "version": "1.0.0",
  "description": "Production-grade RESTful CRM backend for small businesses with customer management, interaction tracking, and owner-only sales analytics.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "test": "node scripts/test-api.js",
    "client": "npm run dev --prefix client",
    "client:build": "npm run build --prefix client"
  },
  "keywords": [
    "crm",
    "express",
    "mongodb",
    "mongoose",
    "rest-api",
    "jwt",
    "aggregation"
  ],
  "author": "Somyajeet",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.6.3",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
